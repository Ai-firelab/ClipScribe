{
  "title": "Instagram Reel Gemini Transcriber",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "reelUrl": {
      "title": "Reel URL",
      "type": "string",
      "description": "A public Instagram Reel URL",
      "editor": "textfield"
    },
    "model": {
      "title": "Gemini model",
      "type": "string",
      "description": "Gemini model used for transcription",
      "default": "gemini-2.5-flash",
      "editor": "textfield"
    },
    "languageHint": {
      "title": "Language hint",
      "type": "string",
      "description": "Optional hint like en, hi, auto",
      "default": "auto",
      "editor": "textfield"
    },
    "keepLocalVideo": {
      "title": "Keep local video",
      "type": "boolean",
      "description": "If true, do not delete the downloaded file after processing",
      "default": false,
      "editor": "checkbox"
    },
    "maxRetries": {
      "title": "Max retries",
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 3,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Proxy used for the Instagram download. Residential proxy is strongly recommended at scale to avoid being blocked.",
      "editor": "proxy",
      "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] }
    }
  },
  "required": ["reelUrl"]
}